# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요. (.env는 GitHub에 올라가지 않아요)
# OpenRouteService API 키: https://openrouteservice.org 에서 무료로 발급
# 비워 두면 '데모 모드'(직선 거리 원)로 동작해요.
ORS_API_KEY=

# 걷는 속도(km/h), 데모 모드에서만 사용
WALKING_SPEED_KMH=4.5

# ---- 로그인과 저장 (docs/login-setup.md 참고) ----
SECRET_KEY=dev-only-change-me
# 비우면 walkmodoro.db 파일(SQLite) 사용
DATABASE_URL=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 출시 (docs/launch-guide.md) ----
CONTACT_EMAIL=
ANDROID_PACKAGE=
ANDROID_SHA256=
